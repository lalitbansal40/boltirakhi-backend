# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — NEVER commit real secrets.

# ---- Core ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# MongoDB Atlas. IMPORTANT: include the DB name (/boltirakhi) before the `?`,
# otherwise Mongoose silently writes to the `test` database.
# If the password contains @ : / ? # [ ] % it must be URL-encoded.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/boltirakhi?retryWrites=true&w=majority

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Minimum 32 characters — validated on boot.
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_SEED_EMAIL=admin@boltirakhi.com
ADMIN_SEED_PASSWORD=

# ---- CORS ----
# Comma separated, no trailing slash.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Razorpay (Phase 2 — optional for now) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Shiprocket (Phase C.6 — optional for now) ----
# Keep SHIPROCKET_ENABLED=false in dev so testing never creates a real shipment.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_ENABLED=false

# ---- Public ----
PUBLIC_SITE_URL=http://localhost:3000
