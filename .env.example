# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — NEVER commit real secrets.

# ---- Core ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# MongoDB Atlas. IMPORTANT: include the DB name (/boltirakhi) before the `?`,
# otherwise Mongoose silently writes to the `test` database.
# If the password contains @ : / ? # [ ] % it must be URL-encoded.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/boltirakhi?retryWrites=true&w=majority

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Minimum 32 characters — validated on boot.
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_SEED_EMAIL=admin@boltirakhi.com
ADMIN_SEED_PASSWORD=

# ---- CORS ----
# Comma separated, no trailing slash.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- AWS S3 ----
# Bucket in ap-south-1 (Mumbai). products/ and categories/ are public-read via
# bucket policy; bolti/ stays private and is served through signed URLs.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional — CloudFront domain once one exists (e.g. https://cdn.boltirakhi.com)
AWS_CDN_DOMAIN=

# ---- Razorpay ----
# test | live. Anything other than "live" is treated as test, so a typo fails
# safe rather than pointing a half-configured build at real money.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Notifications ----
# Leave SMS_ENABLED=false in dev: the OTP is printed to the server log instead
# of being sent, so testing costs nothing and needs no credentials.
SMS_ENABLED=false
SMS_USERNAME=
SMS_PASSWORD=

# Resend. EMAIL_FROM must be on a domain verified with Resend, or every send
# is a 403 that reads like a bad key when the problem is DNS.
RESEND_API_KEY=
# Must be on a domain verified with Resend, e.g. Bolti Rakhi <orders@yourdomain.com>
EMAIL_FROM=

# ---- Shiprocket (Phase C.6 — optional for now) ----
# Keep SHIPROCKET_ENABLED=false in dev so testing never creates a real shipment.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_ENABLED=false

# ---- Public ----
PUBLIC_SITE_URL=http://localhost:3000
