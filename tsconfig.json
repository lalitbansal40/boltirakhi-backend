{
  "compilerOptions": {
    "target": "ES2022",
    // node16 emits CommonJS because package.json has "type": "commonjs".
    // TypeScript 7 removed the legacy "node"/node10 resolution mode.
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "removeComments": true,
    "noUnusedLocals": false,
    "noImplicitReturns": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
