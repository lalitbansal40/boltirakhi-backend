# /var/www/boltirakhi-backend/.env  — PRODUCTION
#
# Local .env se copy MAT karna. Neeche ⚠️ wali har line alag honi chahiye.

NODE_ENV=production
PORT=5000

# ---- Database ----
# Wahi Atlas cluster. ⚠️ EC2 ka Elastic IP Atlas → Network Access me
# whitelist karna PADEGA, warna "server selection timed out" aayega aur
# wajah kahin nahi likhi hogi.
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/boltirakhi?retryWrites=true&w=majority

# ---- Auth ----
# ⚠️ NAYA banao, local wala mat use karna:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ⚠️ Launch se pehle password badlo. Ye panel har order, har customer ka
# phone number, aur behen ki private video tak pahunch deta hai.
ADMIN_SEED_EMAIL=admin@boltirakhi.com
ADMIN_SEED_PASSWORD=

# ---- CORS ----
# ⚠️ https:// lagana. Trailing slash NAHI. Comma se alag, space nahi.
CORS_ORIGINS=https://admin.boltirakhi.com,https://boltirakhi.com

# ---- Public site ----
# ⚠️ SABSE ZAROORI LINE.
# Bolti ka revealUrl isi se banta hai, aur wahi QR me chhapta hai. Ek baar
# QR print ho gaya to use badla nahi ja sakta — galat value yahan ka matlab
# hai har chhapi hui rakhi ka QR bekaar.
PUBLIC_SITE_URL=https://boltirakhi.com

# ---- AWS S3 ----
# Bucket banane ke baad bharo — deploy/s3-setup.md dekho.
# Khaali chhodne par uploads saaf S3_NOT_CONFIGURED deti hain, crash nahi.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_CDN_DOMAIN=

# ---- Razorpay (Phase 2 — public site) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Shiprocket (C.6 — abhi bana nahi) ----
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
# ⚠️ false hi rakhna jab tak C.6 na bane, warna dev testing me asli
# shipment ban sakti hai.
SHIPROCKET_ENABLED=false
